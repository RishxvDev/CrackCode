<?xml version="1.0" encoding="utf-8"?>
<!-- CrackCode mark: a green "</>" code glyph on black. 108-unit adaptive-icon canvas (visible 18..90).
     Also the still splash before Android 12. Replaces the old Prism gem. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft green glow behind the glyph -->
    <path android:pathData="M54,54m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30"
                android:startColor="#33B5FFA8"
                android:endColor="#00B5FFA8" />
        </aapt:attr>
    </path>

    <!-- < -->
    <path
        android:pathData="M36,42L24,54L36,66"
        android:strokeColor="#FFB5FFA8"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- / -->
    <path
        android:pathData="M60,38L48,70"
        android:strokeColor="#FFB5FFA8"
        android:strokeWidth="8"
        android:strokeLineCap="round" />
    <!-- > -->
    <path
        android:pathData="M72,42L84,54L72,66"
        android:strokeColor="#FFB5FFA8"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
